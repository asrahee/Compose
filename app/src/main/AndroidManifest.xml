<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Compose"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Compose">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.main.FullscreenActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"
            android:label="@string/title_activity_fullscreen"
            android:theme="@style/AppCompat.Fullscreen" />

        <activity
            android:name=".ui.main.FullscreenActivityCompose"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"
            android:label="@string/title_activity_fullscreen"
            android:theme="@style/Theme.Compose" />

        <activity
            android:name=".ui.main.layout.pager.HorizontalPagerActivity"
            android:exported="false"
            android:theme="@style/Theme.Compose" />

        <activity
            android:name=".ui.main.layout.flow.FlowActivity"
            android:exported="false"
            android:theme="@style/Theme.Compose" />

        <activity
            android:name=".ui.main.layout.customlayout.CustomLayoutActivity"
            android:exported="false"
            android:theme="@style/Theme.Compose" />

        <activity
            android:name=".ui.main.layout.adaptivelayout.AdaptiveActivity"
            android:exported="false"
            android:theme="@style/Theme.Compose" />

        <activity
            android:name=".ui.main.layout.tracking.TrackingActivity"
            android:exported="false"
            android:theme="@style/Theme.Compose" />

        <activity
            android:name=".ui.main.layout.intrinsic.IntrinsicSizeActivity"
            android:exported="false"
            android:theme="@style/Theme.Compose" />

        <activity
            android:name=".ui.main.layout.constraint.ConstraintLayoutActivity"
            android:exported="false"
            android:theme="@style/Theme.Compose" />
    </application>

</manifest>